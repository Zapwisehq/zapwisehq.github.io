{
  "manifest_version": 3,
  "name": "ZAPWISE//OS New Tab",
  "short_name": "ZAP//OS",
  "version": "1.0.0",
  "description": "Open the live ZAPWISE//OS home screen on every new tab. Free. Updates automatically from zapwiseai.com.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://zapwiseai.com/*"
  ],
  "action": {
    "default_title": "ZAPWISE//OS",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  }
}
